{
  "name": "repo-posture-doctor",
  "version": "0.1.0",
  "description": "Static posture evidence for a local repository folder, with seeded synthetic error rates. Not a score, not a safety certification.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0"
  },
  "bin": {
    "posture-doctor": "dist-cli/cli/main.js"
  },
  "files": [
    "dist-cli/",
    "config/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "build": "vite build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "demo": "tsx scripts/demo.ts",
    "eval": "tsx scripts/eval.ts",
    "materialize": "tsx scripts/materialize.ts",
    "verify-b1": "tsx scripts/verify-b1.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
