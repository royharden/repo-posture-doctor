# [C] §4 layout
corpus/.out/
out/
dist/
dist-cli/
node_modules/

# Never commit real env files; .env.example (comment only) is tracked.
.env
.env.*
!.env.example

# Tool output
*.tsbuildinfo
coverage/
*.log

# Keep local credentials, private keys, archives and generated output out of Git.
.creds/
ArchiveManager-creds.txt
*.pem
*.key
*.p12
*.pfx
*.zip
.cache/
.pytest_cache/
.ruff_cache/
